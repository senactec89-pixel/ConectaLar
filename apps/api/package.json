{
  "name": "@conectalar/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "ConectaLar backend API foundation",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || >=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:local": "start-local.cmd",
    "start": "node dist/main.js",
    "start:local": "start-local.cmd --no-build",
    "db:migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "db:migration:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "diagnostico:local": "node scripts/diagnostico-local.mjs",
    "diagnostico:fluxo": "node scripts/diagnostico-fluxo-local.mjs",
    "diagnostico:mfa": "node scripts/diagnostico-mfa-local.mjs",
    "email:test": "npm run build && node scripts/test-email-local.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/typeorm": "12.0.2",
    "google-auth-library": "^10.5.0",
    "mysql2": "3.24.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "6.0.2"
  }
}
