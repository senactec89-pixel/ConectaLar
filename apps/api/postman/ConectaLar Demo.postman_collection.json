{
  "info": {
    "name": "ConectaLar Demo - API",
    "description": "Colecao para validar a API local com os dados criados por npm run db:seed:demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3012"
    },
    {
      "key": "demoPassword",
      "value": "ConectaLarDemo123!"
    },
    {
      "key": "clienteEmail",
      "value": "cliente.demo@conectalar.local"
    },
    {
      "key": "profissionalEmail",
      "value": "profissional.demo@conectalar.local"
    },
    {
      "key": "adminEmail",
      "value": "admin.demo@conectalar.local"
    },
    {
      "key": "clienteToken",
      "value": ""
    },
    {
      "key": "profissionalToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "profissionalId",
      "value": ""
    },
    {
      "key": "solicitacaoAguardandoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health responde 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Login cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"senha\": \"{{demoPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('cliente logado', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('clienteToken', json.token.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login profissional",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{profissionalEmail}}\",\n  \"senha\": \"{{demoPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('profissional logado', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('profissionalToken', json.token.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{demoPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('admin logado', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('adminToken', json.token.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Perfil do profissional atual",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{profissionalToken}}"
          }
        ],
        "url": "{{baseUrl}}/profissionais/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('perfil profissional responde', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.expect(json.profissional).to.be.an('object');",
              "pm.collectionVariables.set('profissionalId', json.profissional.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Painel profissional",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{profissionalToken}}"
          }
        ],
        "url": "{{baseUrl}}/profissionais/me/painel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('painel profissional responde', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.expect(json.resumo.solicitacoesNovas).to.be.at.least(1);",
              "pm.expect(json.proximosAtendimentos).to.be.an('array');",
              "const aguardando = json.solicitacoesRecentes.find((item) => item.status === 'aguardando_resposta');",
              "if (aguardando) pm.collectionVariables.set('solicitacaoAguardandoId', aguardando.id);",
              "pm.test('endereco completo nao vem exposto no painel', function () {",
              "  pm.expect(JSON.stringify(json)).to.not.include('Rua Demo Protegida');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Servicos do profissional",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{profissionalToken}}"
          }
        ],
        "url": "{{baseUrl}}/profissionais/me/servicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('servicos respondem', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json().servicos).to.be.an('array').that.is.not.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Atualizar servicos do profissional",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{profissionalToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"servicos\": [\n    {\n      \"nome\": \"Instalacao eletrica\",\n      \"precoInicial\": 85\n    },\n    {\n      \"nome\": \"Reparos e manutencao\",\n      \"precoInicial\": 75\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/profissionais/me/servicos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('servicos atualizados', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json().servicos.length).to.eql(2);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Minhas solicitacoes como cliente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{clienteToken}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('cliente ve suas solicitacoes', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json().solicitacoes).to.be.an('array').that.is.not.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Profissional aceita solicitacao aguardando",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{profissionalToken}}"
          }
        ],
        "url": "{{baseUrl}}/solicitacoes/{{solicitacaoAguardandoId}}/aceitar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('aceite valido vira aceita_agendada', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json().solicitacao.status).to.eql('aceita_agendada');"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Painel admin",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/painel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('painel admin responde', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.expect(json.usuarios.administradores).to.be.at.least(1);",
              "pm.expect(json.moderacao.documentosPendentes).to.be.at.least(1);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Admin lista usuarios",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/usuarios?ativo=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('admin lista usuarios', function () { pm.response.to.have.status(200); });",
              "pm.expect(pm.response.json().usuarios).to.be.an('array').that.is.not.empty;"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Permissao negada: cliente no painel admin",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{clienteToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/painel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('cliente nao acessa painel admin', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Permissao negada: cliente no painel profissional",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{clienteToken}}"
          }
        ],
        "url": "{{baseUrl}}/profissionais/me/painel"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('cliente nao acessa painel profissional privado', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
