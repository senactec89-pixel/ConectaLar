NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Required for business modules at runtime and explicit TypeORM CLI operations.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=conectalar_dev

# Authentication and MFA.
AUTH_TOKEN_SECRET=change-this-local-secret-with-at-least-32-characters
MFA_SECRET_ENCRYPTION_KEY=change-this-mfa-secret-with-at-least-32-characters

# OAuth 2.0 Web client ID used as the Google ID-token audience. This is an ID,
# not the OAuth client secret. GOOGLE_OAUTH_CLIENT_IDS accepts a comma-separated
# allow-list when more than one audience is intentionally supported.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_IDS=

# Comma-separated HTTPS origins allowed to call the production API from Web.
CORS_ALLOWED_ORIGINS=

# Optional server-side geocoding. Never expose this key in the Flutter app.
GOOGLE_MAPS_SERVER_API_KEY=
ID_ZAPSIGN_ENABLED=false
ID_ZAPSIGN_API_KEY=

# Password recovery and account verification e-mail. In production, configure a real SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=conectalar.suporte@gmail.com
SMTP_PASSWORD=
SMTP_FROM="ConectaLar <conectalar.suporte@gmail.com>"

# Document malware scanning. Use "required" in production when ClamAV is available.
MALWARE_SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# Private file storage. Use "local" in development and "r2" in production.
FILE_STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_ENDPOINT=
