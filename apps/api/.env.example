NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Used only by an explicit TypeORM CLI operation; API startup does not connect to MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=conectalar_dev

# Authentication and MFA.
AUTH_TOKEN_SECRET=change-this-local-secret-with-at-least-32-characters
MFA_SECRET_ENCRYPTION_KEY=change-this-mfa-secret-with-at-least-32-characters

# Password recovery and account verification e-mail. In production, configure a real SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=conectalar.suporte@gmail.com
SMTP_PASSWORD=
SMTP_FROM="ConectaLar <conectalar.suporte@gmail.com>"
