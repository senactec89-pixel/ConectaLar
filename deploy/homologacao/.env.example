API_DOMAIN=api-homologacao.conectarlar.com

# Use distinct strong passwords for the DB app user and MySQL root.
DB_USER=conectalar_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Generate three different values with: openssl rand -base64 48
AUTH_TOKEN_SECRET=CHANGE_ME_AUTH_SECRET
MFA_SECRET_ENCRYPTION_KEY=CHANGE_ME_MFA_SECRET
EMAIL_OUTBOX_ENCRYPTION_KEY=CHANGE_ME_OUTBOX_SECRET

# Required for production-mode API startup. Use an SMTP account/app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ConectaLar Homologacao <seu-email@example.com>"
SMTP_EHLO_NAME=api-homologacao.conectarlar.com

# Optional: web origins only; native Android requests do not need CORS origins.
CORS_ALLOWED_ORIGINS=

# Optional Google OAuth Web client ID. Set it if Google sign-in is tested; the
# API's accepted audience defaults to this value when GOOGLE_OAUTH_CLIENT_IDS is blank.
# Do not put an Android Maps key here.
GOOGLE_WEB_CLIENT_ID=
# Optional comma-separated extra token audiences. Leave blank for the usual setup.
GOOGLE_OAUTH_CLIENT_IDS=
# Optional API key for server-side address geocoding, not for displaying the map.
GOOGLE_MAPS_SERVER_API_KEY=
